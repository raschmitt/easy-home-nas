{
	email {$TANDEM_ACME_EMAIL}
	servers {
		# Without this, {remote_host} resolves to whatever sits directly in
		# front of Caddy on the docker network — the cloudflared container's
		# own IP when using Path B (Cloudflare Tunnel), the same for every
		# visitor. That collapses the rate limiter below into one shared
		# bucket for the entire site instead of one per real visitor.
		# private_ranges covers both cloudflared (Path B) and a reverse
		# proxy/router on the LAN (Path A); Cloudflare's own edge IPs are
		# additionally checked against Cf-Connecting-Ip.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		# Nextcloud sets its own CSP; don't fight it here.
		-Server
	}
}

{$TANDEM_CADDY_ADDRESS_PREFIX}{$TANDEM_PUBLIC_DOMAIN} {
	import security_headers

	# Rate-limit auth endpoints hardest: brute-force protection in depth,
	# on top of Nextcloud's own brute-force throttling and fail2ban.
	rate_limit {
		zone login_zone {
			match {
				path /login*
				path /ocs/v2.php/core/getapppassword*
			}
			key {remote_host}
			events 20
			window 1m
		}
		# File sync/upload (WebDAV) is legitimate high-frequency traffic —
		# a phone backing up a camera roll fires one PUT per photo, easily
		# bursting past a login-strength limit. Separate, much higher
		# ceiling than login_zone; still per real visitor IP now that
		# trusted_proxies (above) is set.
		zone dav_zone {
			match {
				path /remote.php/dav*
			}
			key {remote_host}
			events 6000
			window 1m
		}
		zone general_zone {
			key {remote_host}
			events 300
			window 1m
		}
	}

	# Nextcloud needs these redirects/headers for CalDAV/CardDAV discovery.
	redir /.well-known/carddav /remote.php/dav 301
	redir /.well-known/caldav /remote.php/dav 301

	reverse_proxy nextcloud:80

	log {
		output file /var/log/caddy/access.log
		format json
	}
}
