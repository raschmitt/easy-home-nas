# Easy Home NAS — example environment file
#
# Copy this to `.env` and fill in real values for YOUR machine.
# `.env` is git-ignored — never commit it. No value in this file is real.

# ---------------------------------------------------------------------------
# Storage — physical disks (main mirrored pool)
# ---------------------------------------------------------------------------
# Use stable /dev/disk/by-id/... paths, NEVER /dev/sdX (those change across
# reboots and disk re-ordering). List as many disks as you want mirrored;
# the zfs-mirror Ansible role turns this into `zpool create ... mirror <disks>`.
# Find yours with: ls -la /dev/disk/by-id/
TANDEM_ZFS_POOL_NAME=tandem
TANDEM_ZFS_DISK_1=/dev/disk/by-id/ata-REPLACE_WITH_YOUR_DISK_1
TANDEM_ZFS_DISK_2=/dev/disk/by-id/ata-REPLACE_WITH_YOUR_DISK_2

# Dataset used for Nextcloud data, mounted into the container.
TANDEM_ZFS_DATASET_NEXTCLOUD=tandem/nextcloud
TANDEM_ZFS_MOUNTPOINT_NEXTCLOUD=/srv/tandem-nas/nextcloud-data

# Optional overall reservation (bytes suffix, e.g. 50G) protecting headroom
# on the pool for snapshots. Leave empty to skip.
TANDEM_ZFS_RESERVATION=

# Safety switch: the zfs-mirror role refuses to create the pool if either
# target disk already has a filesystem/partition signature, to avoid
# silently destroying data. Only set this to true if you've confirmed the
# disk(s) really are meant to be wiped.
TANDEM_ZFS_CONFIRM_WIPE=false

# ---------------------------------------------------------------------------
# Backup — external/removable disk + restic
# ---------------------------------------------------------------------------
# Filesystem LABEL burned onto the backup disk by scripts/prepare-backup-disk.sh.
# The udev rule matches on this label, not "any USB disk", so plugging in an
# unrelated USB drive never triggers a backup.
TANDEM_BACKUP_DISK_LABEL=TANDEM_BACKUP
TANDEM_BACKUP_MOUNTPOINT=/mnt/tandem-backup

# restic repository location. For the local external disk this is a path
# under the mountpoint above. To add a cloud backend later, replace this
# with the corresponding restic URL (s3:, b2:, azure:, gs:, sftp:, swift:)
# and set the matching credentials below — restic itself decides the backend
# from this URL, no code change needed.
RESTIC_REPOSITORY=/mnt/tandem-backup/restic-repo
RESTIC_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSPHRASE

# --- Cold storage hook (optional, disabled by default) ---------------------
# Leave these empty until you want an additional off-site copy. restic
# supports many backends; uncomment/fill only the block for the one you use.
# Any restic-supported backend works here without touching scripts/backup.sh.
#
# AWS S3 / S3-compatible (also covers Backblaze B2 S3 API, Wasabi):
#   RESTIC_REPOSITORY_COLD=s3:s3.us-east-1.amazonaws.com/my-easy-home-nas-bucket
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#
# Backblaze B2 native API:
#   RESTIC_REPOSITORY_COLD=b2:my-bucket:path
#   B2_ACCOUNT_ID=
#   B2_ACCOUNT_KEY=
#
# Google Cloud Storage:
#   RESTIC_REPOSITORY_COLD=gs:my-bucket:path
#   GOOGLE_PROJECT_ID=
#   GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-credentials.json
#
# Azure Blob Storage:
#   RESTIC_REPOSITORY_COLD=azure:my-container:path
#   AZURE_ACCOUNT_NAME=
#   AZURE_ACCOUNT_KEY=
RESTIC_REPOSITORY_COLD=
RESTIC_PASSWORD_COLD=

# ---------------------------------------------------------------------------
# Nextcloud
# ---------------------------------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
NEXTCLOUD_TRUSTED_DOMAIN=nas.example.com

# Default per-user storage quota for newly provisioned users (Nextcloud
# quota syntax: e.g. 10G, 500M, "none" for unlimited). Overridden per-user
# via scripts/provision-user.sh --quota.
NEXTCLOUD_DEFAULT_QUOTA=20G

# Database backing Nextcloud (Postgres, run as its own container).
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

REDIS_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# ---------------------------------------------------------------------------
# Remote access — domain + HTTPS (Caddy + Let's Encrypt)
# ---------------------------------------------------------------------------
# Public domain/subdomain pointing at this machine's public IP. Required for
# Let's Encrypt to issue a certificate. See docs/remote-access.md for DDNS
# guidance if your ISP gives you a dynamic IP.
TANDEM_PUBLIC_DOMAIN=nas.example.com
TANDEM_ACME_EMAIL=you@example.com

# Leave empty (default) if this machine has real inbound access to 80/443 —
# Caddy manages its own Let's Encrypt certificate directly.
#
# Set to "http://" instead if you're behind CG-NAT or an ISP that blocks
# inbound ports and are using Cloudflare Tunnel (see docs/remote-access.md):
# Cloudflare terminates public HTTPS at its edge using its own certificate,
# so Caddy only needs to serve plain HTTP to the tunnel and should not also
# try (and keep failing) to get its own Let's Encrypt certificate.
TANDEM_CADDY_ADDRESS_PREFIX=

# ---------------------------------------------------------------------------
# Host hardening (opt-in — see docs/remote-access.md before enabling)
# ---------------------------------------------------------------------------
# Disables SSH password authentication (key-only). The hardening role
# refuses to apply this unless it finds a working authorized_keys file for
# the admin user first, but it's still off by default to avoid any risk of
# lockout on a machine you're already using.
TANDEM_HARDEN_SSH=false

# ---------------------------------------------------------------------------
# Host paths (used by docker-compose.yml bind mounts — keep in sync with the
# ZFS mountpoint above)
# ---------------------------------------------------------------------------
TANDEM_DATA_ROOT=/srv/tandem-nas

# Timezone for containers that care (fail2ban ban timestamps, log rotation).
TZ=UTC
