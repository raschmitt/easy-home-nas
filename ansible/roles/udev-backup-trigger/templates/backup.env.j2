# {{ ansible_managed }}
# Root-only (0600): contains the restic repository passphrase.
TANDEM_BACKUP_MOUNTPOINT={{ tandem_backup_mountpoint }}
TANDEM_ZFS_MOUNTPOINT_NEXTCLOUD={{ tandem_zfs_mountpoint_nextcloud }}
RESTIC_REPOSITORY={{ restic_repository }}
RESTIC_PASSWORD={{ restic_password }}
{% if restic_repository_cold | length > 0 %}
RESTIC_REPOSITORY_COLD={{ restic_repository_cold }}
RESTIC_PASSWORD_COLD={{ restic_password_cold }}
{% endif %}
