# Secrets and local configuration — never commit real values
.env
ansible/inventory.ini
docker-compose.override.yml
docker/cloudflared/config.yml
docker/cloudflared/credentials.json
*.retry

# Nextcloud / app runtime data (bind-mounted from the host, not repo content)
data/
nextcloud-data/

# restic cache
.restic-cache/

# OS / editor cruft
.DS_Store
*.swp
*~

# Local Claude Code session state, not part of the project
.claude/

# Ansible
*.retry
.vault-pass

# Terraform (terraform/) — state contains the tunnel secret, tfvars contain
# account/zone IDs. The dependency lock file (.terraform.lock.hcl) is NOT
# ignored — it's meant to be committed for reproducible provider versions.
terraform/.terraform/
terraform/terraform.tfvars
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfplan
